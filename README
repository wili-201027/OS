# 1. Limpia todo rastro anterior
rm -rf build/obj/* build/kernel.elf

# 2. Compila el proyecto
make -f build/kernel.mk all

# 3. Verifica el nuevo 'File off'
/c/opt/cross/bin/x86_64-elf-objdump -h build/kernel.elf

qemu-system-x86_64 -cdrom D:/VSC/GPT_OS/os/build/os.iso -m 2G -vga std -d int,cpu_reset -no-reboot -no-shutdown
qemu-system-x86_64 -cdrom build/os.iso -m 2G -vga std -serial stdio -no-reboot -no-shutdown
qemu-system-x86_64 -cdrom D:/VSC/GPT_OS/os/build/os.iso -m 2G -vga std -serial stdio -no-reboot -no-shutdown